# Streamlit secrets example — for Streamlit Community Cloud or local secrets.
#
# Local use:  copy this file to .streamlit/secrets.toml (it is git-ignored)
# Hosted use: paste the same content into your app's Settings -> Secrets
#             on https://share.streamlit.io
#
# The app reads FINNHUB_API_KEY from (in priority order):
#   1. the sidebar "Finnhub API key" field (session only)
#   2. Streamlit secrets (this file / the Cloud Secrets box)
#   3. the FINNHUB_API_KEY environment variable / .env

FINNHUB_API_KEY = "your_key_here"
