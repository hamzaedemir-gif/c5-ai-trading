# C5 v1 configuration — copy to .env and edit.
# The app runs with NO configuration at all (mock mode is the default).

# Data feed mode: mock | manual | finnhub | webull
# - mock   : synthetic prices, runs immediately, no key needed (DEFAULT)
# - manual : you type prices into the UI
# - finnhub: live US-equity quotes/candles (requires FINNHUB_API_KEY)
# - webull : PLACEHOLDER ONLY — pending OpenAPI approval, not functional
C5_DATA_MODE=mock

# Finnhub API key (only used when C5_DATA_MODE=finnhub). Leave blank otherwise.
FINNHUB_API_KEY=

# Starting paper-account balance (USD).
C5_STARTING_CASH=1000

# Default symbol shown on launch.
C5_DEFAULT_SYMBOL=AAPL

# Path to the SQLite database file.
C5_DB_PATH=data/c5.db
