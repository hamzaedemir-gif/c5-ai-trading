# Copy to .env and fill in. Never commit .env.

# Price data (yfinance needs no key; Alpaca is optional)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Earnings + news (free tier available)
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Social sentiment (optional; we ship a free stub fallback)
STOCKTWITS_BASE_URL=https://api.stocktwits.com/api/2

# Storage
C5_DB_PATH=c5_data.sqlite

# Trading mode: paper | live (default paper; live requires explicit opt-in)
C5_TRADING_MODE=paper

# Risk parameters
C5_STARTING_CAPITAL=10000
C5_POSITION_PCT=0.02
C5_STOP_LOSS_PCT=0.03
C5_DAILY_MAX_LOSS_PCT=0.05
