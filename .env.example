# Copy to .env and fill in. Never commit .env.

# --- Real-time price feed (Alpaca, free tier OK) -----------------------------
# Sign up at https://alpaca.markets/ -> "Paper Trading" -> "Generate API Keys".
# The free IEX data feed is sufficient for live quotes/trades.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex                  # iex (free) | sip (paid)
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_SYMBOLS=AAPL,MSFT,TSLA,NVDA,AMD,SPY,QQQ

# --- Historical backfill (yfinance, no key needed) ---------------------------
# Used only for historical bars; real-time comes from Alpaca above.

# --- Earnings + news (Finnhub, free tier) ------------------------------------
# Sign up at https://finnhub.io/ -> dashboard shows your free API key.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Social sentiment (StockTwits public stream) -----------------------------
STOCKTWITS_BASE_URL=https://api.stocktwits.com/api/2

# --- Storage -----------------------------------------------------------------
C5_DB_PATH=c5_data.sqlite

# --- Trading mode ------------------------------------------------------------
# paper (default) | live (NOT WIRED UP -- this repo never routes orders).
C5_TRADING_MODE=paper

# --- Risk parameters ---------------------------------------------------------
C5_STARTING_CAPITAL=10000
C5_POSITION_PCT=0.02
C5_STOP_LOSS_PCT=0.03
C5_DAILY_MAX_LOSS_PCT=0.05

# --- API server --------------------------------------------------------------
C5_API_HOST=0.0.0.0
C5_API_PORT=8000
# Comma-separated origins allowed for the React frontend (CORS).
C5_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
